{
  "name": "@fcc-china/ows",
  "version": "2.4.0",
  "description": "欢迎来到 freeCodeCamp 中文社区！与编程爱好者们一起探索全国不同城市的线下技术社区，从技术交流到结对编程，与我们一起分享，共同成长。",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@giscus/react": "^3.1.0",
    "idea-react": "^3.0.0-beta.5",
    "koa": "^3.3.0",
    "koajax": "^3.3.1",
    "less": "^4.9.1",
    "less-loader": "^13.1.0",
    "lodash": "^4.18.1",
    "marked": "^18.1.3",
    "mobx": "^7.1.5",
    "mobx-github": "^0.7.1",
    "mobx-i18n": "^0.7.9",
    "mobx-react": "^10.0.3",
    "mobx-react-helper": "^0.5.4",
    "mobx-restful": "^2.1.5",
    "mobx-restful-table": "^3.0.0-rc.0",
    "mobx-supabase": "^0.1.0",
    "next": "^16.4.5",
    "next-pwa": "~5.6.0",
    "next-ssr-middleware": "^1.1.5",
    "next-with-less": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.4",
    "web-utility": "^4.8.1"
  },
  "devDependencies": {
    "@softonus/prettier-plugin-duplicate-remover": "^1.1.2",
    "@types/koa": "^3.0.3",
    "@types/lodash": "^4.17.27",
    "@types/next-pwa": "^5.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-idea2app-next-js": "^0.1.1",
    "git-utility": "^0.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "next": "$next"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-css-order",
      "@softonus/prettier-plugin-duplicate-remover"
    ]
  },
  "lint-staged": {
    "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write",
    "*.{js,mjs,ts,tsx}": "eslint --fix"
  },
  "scripts": {
    "prepare": "husky || true",
    "install": "next typegen",
    "postinstall": "xgit download https://github.com/freeCodeCamp-China/key-vault main Web-site  ||  true",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "lint-staged  &&  tsc --noEmit",
    "pack-image": "docker build -t freecodecamp-china/web-site:latest .",
    "container": "docker rm -f web-site  &&  docker run --name web-site -p 3000:3000 -d freecodecamp-china/web-site:latest"
  }
}
